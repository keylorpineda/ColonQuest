{
  "$defs": {
    "CreditCard": {
      "additionalProperties": false,
      "properties": {
        "balance": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Balance",
          "type": "integer"
        },
        "limit": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "minPaymentPct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Minpaymentpct",
          "type": "number"
        },
        "monthlyRatePct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Monthlyratepct",
          "type": "number"
        }
      },
      "required": [
        "balance",
        "limit",
        "monthlyRatePct",
        "minPaymentPct"
      ],
      "title": "CreditCard",
      "type": "object"
    },
    "GameLanguage": {
      "enum": [
        "es",
        "en"
      ],
      "title": "GameLanguage",
      "type": "string"
    },
    "InformalLoan": {
