          "dealsAccepted": {
            "title": "Dealsaccepted",
            "type": "integer"
          },
          "decisions": {
            "title": "Decisions",
            "type": "integer"
          },
          "keyQuestionsAsked": {
            "items": {
              "$ref": "#/components/schemas/KeyQuestion"
            },
            "title": "Keyquestionsasked",
            "type": "array"
          },
          "monthsPlayed": {
            "title": "Monthsplayed",
            "type": "integer"
          },
          "narrative": {
            "title": "Narrative",
            "type": "string"
          },
          "negotiations": {
            "title": "Negotiations",
            "type": "integer"
          },
          "netWorth": {
            "title": "Networth",
            "type": "integer"
          },
          "source": {
            "enum": [
              "model",
              "fallback"
            ],
            "title": "Source",
            "type": "string"
          },
          "totalDebt": {
            "title": "Totaldebt",
            "type": "integer"
          }
        },
        "required": [
          "monthsPlayed",
          "decisions",
          "conceptsTaught",
          "negotiations",
          "dealsAccepted",
          "keyQuestionsAsked",
          "totalDebt",
          "netWorth",
          "narrative",
          "source",
          "cardImageKey"
        ],
        "title": "SessionSummary",
        "type": "object"
      },
      "SessionTrace": {
        "additionalProperties": false,
        "description": "What the models and agents did in a session, for the judges' demo. Newest calls last.",
        "properties": {
          "calls": {
            "items": {
              "$ref": "#/components/schemas/ModelCallInfo"
            },
            "title": "Calls",
            "type": "array"
          },
          "seasonPlan": {
            "items": {
              "$ref": "#/components/schemas/PlanMonthInfo"
            },
            "title": "Seasonplan",
            "type": "array"
          },
          "toolSteps": {
            "items": {
              "$ref": "#/components/schemas/ToolStepInfo"
            },
            "title": "Toolsteps",
            "type": "array"
          },
          "totalCostUsd": {
            "title": "Totalcostusd",
            "type": "number"
          }
        },
        "required": [
          "calls",
          "toolSteps",
          "seasonPlan",
          "totalCostUsd"
        ],
        "title": "SessionTrace",
        "type": "object"
      },
      "TeachingConcept": {
        "enum": [
          "budget",
          "emergency_fund",
          "compound_interest",
          "minimum_payment",
          "installments_total_cost",
          "informal_lending",
          "pyramid_scheme",
          "inflation",
          "exchange_rate",
          "payroll_deductions",
          "invest_in_yourself"
        ],
        "title": "TeachingConcept",
        "type": "string"
      },
      "ToolStepInfo": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "title": "Arguments",
            "type": "string"
          },
          "endpoint": {
            "title": "Endpoint",
            "type": "string"
          },
          "result": {
            "title": "Result",
            "type": "string"
          },
          "step": {
            "title": "Step",
            "type": "integer"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "endpoint",
          "step",
          "tool",
          "arguments",
          "result"
        ],
        "title": "ToolStepInfo",
        "type": "object"
      },
      "TranscriptResponse": {
        "additionalProperties": false,
        "properties": {
          "transcript": {
            "minLength": 1,
            "title": "Transcript",
            "type": "string"
          }
        },
        "required": [
          "transcript"
        ],
        "title": "TranscriptResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Backend for the Colón Quest financial-literacy game.",
    "title": "Colón Quest API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/classes": {
      "post": {
        "description": "Create a class and return the short code students type when they start a game.",
        "operationId": "create_class_api_classes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClassRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Class",
        "tags": [
          "classes"
        ]
      }
    },
    "/api/classes/{code}/dashboard": {
      "get": {
        "operationId": "class_dashboard_api_classes__code__dashboard_get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "pattern": "^[A-Z0-9]{4,8}$",
              "title": "Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/GameLanguage",
              "default": "es"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassDashboard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Class Dashboard",
        "tags": [
          "classes"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Always answers 200 so uptime checks see the process; the body says what is degraded.",
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/images/{key}": {
      "get": {
        "description": "Return a cached portrait or scene by key, generating it with Muse Image only if missing.",
        "operationId": "get_image_api_images__key__get",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9_ñ]+$",
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "Cached or newly generated pixel-art PNG image."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Image",
        "tags": [
          "images"
        ]
      }
    },
    "/api/ping": {
      "get": {
        "description": "Keep-alive for UptimeRobot: wakes Render without touching Neon or any model.",
        "operationId": "ping_api_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ping",
        "tags": [
          "health"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "description": "Start a game. A classCode joins the session to a Class Mode class.",
        "operationId": "create_session_api_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}/decisions": {
      "post": {
        "description": "Store the choice the player made and the resulting state (impact telemetry).",
        "operationId": "record_decision_api_sessions__session_id__decisions_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionRecorded"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Record Decision",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}/event": {
      "post": {
        "description": "Return this month's event. Never fails because of the model: it falls back instead.\n\nThe ``X-Event-Source`` header says whether the event came from the model, the cache or the\nhand-written fallback catalog.",
        "operationId": "next_event_api_sessions__session_id__event_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayerState"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameEvent"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Next Event",
        "tags": [
          "events"
        ]
      }
    },
    "/api/sessions/{session_id}/negotiation": {
      "post": {
        "description": "One negotiation turn with typed text (always available as the fallback to voice).",
        "operationId": "negotiate_text_api_sessions__session_id__negotiation_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NegotiationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NegotiationReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Negotiate Text",
        "tags": [
          "negotiation"
        ]
      }
    },
    "/api/sessions/{session_id}/negotiation/voice": {
      "post": {
        "description": "One negotiation turn spoken by the player, for builds older than /transcribe.\n\nIf voice fails the response is 503 and the client switches to the text endpoint, so the\nnegotiation never blocks.",
        "operationId": "negotiate_voice_api_sessions__session_id__negotiation_voice_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_negotiate_voice_api_sessions__session_id__negotiation_voice_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NegotiationReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Negotiate Voice",
        "tags": [
          "negotiation"
        ]
      }
    },
    "/api/sessions/{session_id}/summary": {
      "post": {
        "description": "Compute the final figures, write the narrative and close the session (409 afterwards).",
        "operationId": "finish_session_api_sessions__session_id__summary_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayerState"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Finish Session",
        "tags": [
          "summary"
        ]
      }
    },
    "/api/sessions/{session_id}/trace": {
      "get": {
        "description": "The session's model calls, tool steps and season plan. Finished sessions still answer.",
        "operationId": "session_trace_api_sessions__session_id__trace_get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTrace"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Session Trace",
        "tags": [
          "trace"
        ]
      }
    },
    "/api/sessions/{session_id}/transcribe": {
      "post": {
        "description": "Only the player's words, so the game can show them at once and then ask the seller.",
        "operationId": "transcribe_api_sessions__session_id__transcribe_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_transcribe_api_sessions__session_id__transcribe_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Transcribe",
        "tags": [
          "negotiation"
        ]
      }
    }
  }
}
