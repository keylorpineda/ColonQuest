{
  "$defs": {
    "DealStatus": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "walked_away"
      ],
      "title": "DealStatus",
      "type": "string"
    },
    "KeyQuestion": {
      "description": "Questions a financially literate player should ask (impact metric).",
      "enum": [
        "total_cost",
        "hidden_fees",
        "interest_rate",
        "term",
        "cash_price",
        "insurance"
      ],
      "title": "KeyQuestion",
      "type": "string"
    },
    "SellerFact": {
      "description": "Facts on the hidden seller sheet that the NPC can reveal.",
      "enum": [
        "cash_price",
        "monthly_payment",
        "term_months",
        "interest_rate",
        "insurance_fee",
        "commission",
        "total_cost"
      ],
      "title": "SellerFact",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dealStatus": {
      "$ref": "#/$defs/DealStatus"
    },
    "keyQuestionsAsked": {
      "items": {
        "$ref": "#/$defs/KeyQuestion"
      },
      "maxItems": 6,
      "title": "Keyquestionsasked",
      "type": "array"
    },
    "npcReply": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Npcreply",
      "type": "string"
    },
    "revealedFacts": {
      "items": {
        "$ref": "#/$defs/SellerFact"
      },
      "maxItems": 7,
      "title": "Revealedfacts",
      "type": "array"
    },
    "transcript": {
      "maxLength": 1000,
      "title": "Transcript",
      "type": "string"
    }
  },
  "required": [
    "transcript",
    "npcReply",
    "dealStatus"
  ],
  "title": "NegotiationReply",
  "type": "object"
}
