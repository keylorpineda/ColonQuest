{
  "$defs": {
    "GameLanguage": {
      "enum": [
        "es",
        "en"
      ],
      "title": "GameLanguage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "language": {
      "$ref": "#/$defs/GameLanguage",
      "default": "es"
    },
    "offerId": {
      "pattern": "^[a-z0-9_]{1,40}$",
      "title": "Offerid",
      "type": "string"
    },
    "termMonths": {
      "default": 0,
      "maximum": 120,
      "minimum": 0,
      "title": "Termmonths",
      "type": "integer"
    },
    "text": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "offerId",
    "text"
  ],
  "title": "NegotiationRequest",
  "type": "object"
}
