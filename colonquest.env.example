# Which backend the game talks to. Copy to colonquest.env; scripts/build_game.py puts it beside the exe,
# and it can still be edited there without building again. Nothing secret goes here: the API keys
# live in server/.env.

# The hosted backend. For your own: http://localhost:8000/api
COLONQUEST_API_URL=https://colon-quest-api.onrender.com/api
