# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MODEL_TIMEOUT_S=8
DATABASE_URL=postgresql+psycopg://user:password@host/dbname
GAME_MASTER_MODEL=muse-spark-1.3-contributor
SUMMARY_MODEL=muse-spark-1.3-contributor
IMAGE_MODEL=muse-image-1.0
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
DAILY_BUDGET_USD=5
ALLOWED_ORIGINS=http://localhost:8000
DOWNGRADE_MODEL=muse-spark-1.3
MAX_CALLS_PER_SESSION=40
MAX_CALLS_PER_CLIENT_PER_DAY=200
RESPONSE_CACHE_TTL_S=3600
RESPONSE_CACHE_MAX_ENTRIES=500
CLIENT_HASH_SALT=
LOG_LEVEL=INFO
# Open-weights NPCs (only if Baseten or Modal credits are approved)
NPC_PROVIDER=meta_api
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_NPC_MODEL=muse-spark-open
OPEN_WEIGHTS_TIMEOUT_S=4
