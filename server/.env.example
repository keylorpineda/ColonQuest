# Copy to .env and fill in the three marked values. Never commit .env.
# These are the values the hosted backend runs with (render.yaml). See RUN_AND_BUILD.md.

# --- Fill these in ---
# Your key for the Meta Model API.
MODEL_API_KEY=
# Your Baseten key, for Muse Spark Open. Without one, set NPC_PROVIDER=meta_api.
OPEN_WEIGHTS_API_KEY=
# Your Postgres database.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# --- Models ---
META_BASE_URL=https://api.meta.ai/v1
MODEL_TIMEOUT_S=8
LIVE_REASONING_EFFORT=minimal
GAME_MASTER_MODEL=muse-spark-1.3
SUMMARY_MODEL=muse-wonder-1.0
SUMMARY_TIMEOUT_S=25
CLASS_REPORT_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0
IMAGE_TIMEOUT_S=30
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# --- The characters, on open weights in Baseten; Meta takes over if it fails ---
NPC_PROVIDER=open_weights
OPEN_WEIGHTS_BASE_URL=https://inference.baseten.co/v1
OPEN_WEIGHTS_NPC_MODEL=meta-models/muse-spark-open-1026
OPEN_WEIGHTS_TIMEOUT_S=5
OPEN_WEIGHTS_DAILY_BUDGET_USD=3

# --- Agents ---
AGENTIC_GAME_MASTER=true
SEASON_PLANNER=true
PLANNER_MODEL=muse-wonder-1.0
PLANNER_TIMEOUT_S=30
SELLER_AGENT=true
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_S=10

# --- Limits and costs ---
DAILY_BUDGET_USD=5
DOWNGRADE_MODEL=muse-spark-1.3
MAX_CALLS_PER_SESSION=40
MAX_CALLS_PER_CLIENT_PER_DAY=200
RESPONSE_CACHE_TTL_S=3600
RESPONSE_CACHE_MAX_ENTRIES=500

# --- Server ---
ALLOWED_ORIGINS=http://localhost:8000
CLIENT_HASH_SALT=
LOG_LEVEL=INFO
