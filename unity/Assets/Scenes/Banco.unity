  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a74c1e6db141f04fb3f6860c3522323, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ColonQuest.World::ColonQuest.World.Station
  type: 10
  displayName: "Hablar con la asesora de cr\xE9ditos"
  lines:
  - "\"Un pr\xE9stamo personal aqu\xED cobra mucho menos inter\xE9s que el prestamista
    del barrio. Pregunte siempre la tasa anual.\""
  - "\"Antes de firmar un cr\xE9dito, pida el costo total: la cuota por los meses,
    m\xE1s seguros y comisiones.\""
  - "\"Para darle un cr\xE9dito revisamos que la cuota no pase de un tercio de su
    salario. M\xE1s que eso ahoga.\""
