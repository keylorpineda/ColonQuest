  m_Script: {fileID: 11500000, guid: 4a74c1e6db141f04fb3f6860c3522323, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ColonQuest.World::ColonQuest.World.Station
  type: 10
  displayName: Hablar con el gerente
  lines:
  - "\"Bienvenido. Si alg\xFAn d\xEDa tiene un problema con un cobro, venga a hablar
    antes de dejar de pagar.\""
  - '"El banco gana con los intereses que usted paga. Por eso conviene pagar la tarjeta
    completa cada mes."'
