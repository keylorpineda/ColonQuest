  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a74c1e6db141f04fb3f6860c3522323, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ColonQuest.World::ColonQuest.World.Station
  type: 10
  displayName: Hablar con el del puesto
  lines:
  - "Triplic\xE1 tu plata en un mes. Solo tra\xE9 efectivo y no le cont\xE9s a nadie."
  - "Es seguro, es seguro. Papeles no tengo, pero confi\xE1 en m\xED."
  - "Con los {cash} que ten\xE9s hoy, ma\xF1ana tendr\xEDas el triple. Eso me dijeron
    mis clientes."
  - "Nadie puede garantizar 300% en un mes. Un negocio as\xED se llama esquema piramidal:
    gana el que entra primero."
