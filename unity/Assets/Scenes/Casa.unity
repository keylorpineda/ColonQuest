  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a74c1e6db141f04fb3f6860c3522323, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ColonQuest.World::ColonQuest.World.Station
  type: 10
  displayName: "Hablar con tu mam\xE1"
  lines:
  - "\"Antes de comprar algo, esper\xE1 un d\xEDa. Si al otro d\xEDa lo segu\xEDs
    queriendo, ah\xED s\xED.\""
  - "\"Apart\xE1 primero para el ahorro y despu\xE9s gast\xE1s. Al rev\xE9s nunca
    alcanza.\""
  - "\"Si alguien te ofrece plata f\xE1cil, desconfi\xE1. Nadie regala nada.\""
