  m_Script: {fileID: 11500000, guid: 4a74c1e6db141f04fb3f6860c3522323, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ColonQuest.World::ColonQuest.World.Station
  type: 10
  displayName: Preguntar por el ahorro a plazo
  lines:
  - "\"En el ahorro a plazo deja la plata quieta unos meses y le pagamos m\xE1s inter\xE9s
    que en una cuenta normal.\""
  - "\"A diferencia del banco, aqu\xED usted es asociado: las ganancias de la cooperativa
    se reparten entre los socios.\""
  - "\"Si saca la plata antes del plazo, pierde parte del inter\xE9s. Ahorre a plazo
    solo lo que no va a ocupar.\""
